#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
// 実行時マクロの &rmacro <スロット>。DYA Studio で作ったマクロをキーやコンボに割り当てるのに必要
#include <behaviors/runtime_macro.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        // 非推奨の label の代わりにノード名を大文字にして、behavior の内部名を "TO_LAYER_0" のまま保つ。
        // 内部名が変わると、DYA Studio などで本体に保存した割り当てが解決できなくなる
        to_layer_0: TO_LAYER_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to_keep 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
        };
    };

    behaviors {
        // レイヤー 0 へ戻る。ZMK 標準の &to はロック付きのレイヤーまで解除するので、
        // OS 別の既定レイヤー（OS レイヤー）が A+S コンボで消えてしまう。ロックされたレイヤーは残す版を使う
        to_keep: to_keep {
            compatible = "zmk,behavior-to-layer";
            #binding-cells = <1>;
            display-name = "To Layer (keep locked)";
        };

        // ロータリーエンコーダー: DYA Studio でランタイムに割り当て変更可能。
        // cw-binding/ccw-binding はデフォルト値で、Studio 設定があれば上書きされる。
        // tap-ms は 1 クリックで割り当てを押している時間で、DYA Studio で新しく割り当てるときの
        // Tap Time の初期値にもなる（保存済みの割り当ては、保存したときの値のまま）。
        // マウススクロール（&msc）は押してから 16 ms 後に最初の量を送るので、16 より短いとスクロールしない

        // 既定レイヤー用: マウスホイールと同じ縦スクロール。向きは Windows のホイールに合わせ、
        // 以前 PageUp を割り当てていた回転方向が上スクロールになる。
        // &msc は押している間、16 ms ごとに「値 × 16 / 1000」段を送る。tap-ms が 16 なので 1 クリックで
        // 1 回だけ送られ、値 100 なら 1.6 → 1 段になる（ZMK 既定の SCRL_UP は値が 10 で、0.16 段にしか
        // ならずスクロールしない）
        rsr_scroll: rsr_scroll {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <16>;
            cw-binding = <&msc MOVE_Y(100)>;
            ccw-binding = <&msc MOVE_Y(-100)>;
        };

        rsr_tab: rsr_tab {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <16>;
            cw-binding = <&kp LC(PAGE_UP)>;
            ccw-binding = <&kp LC(PAGE_DOWN)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // display-name の先頭にレイヤー番号を入れる。Studio で &mo や &lt のレイヤーを選ぶときに、
        // どの番号がどのレイヤーかを見分けるため。レイヤーを並べ替えたら番号も直す
        default_layer {
            display-name = "0 BASE";
            bindings = <
&kp Q             &kp W         &kp E         &kp R        &kp T                                        &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A             &kp S         &kp D         &kp F        &kp G        &kp ESC          &kp EQUAL      &kp H        &kp J  &kp K      &kp L    &kp MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V        &kp B        &kp TAB          &kp B          &kp N        &kp M  &kp COMMA  &kp DOT  &mt LEFT_SHIFT SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt 6 LANG2  &lt 2 SPACE  &lt 3 LANG1      &kp BACKSPACE  &lt 1 ENTER                             &kp DEL
            >;

            sensor-bindings = <&rsr_scroll>;
        };

        FUNCTION {
            display-name = "1 FUNCTION";
            bindings = <
&trans     &kp AMPERSAND    &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS                      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans         &trans             &trans
&kp TILDE  &kp DOLLAR       &kp PERCENT   &kp CARET             &trans                 &trans      &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp SEMICOLON  &kp SINGLE_QUOTE   &kp BACKSLASH
&kp GRAVE  &kp EXCLAMATION  &kp AT        &kp HASH              &trans                 &trans      &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp COLON      &kp DOUBLE_QUOTES  &kp PIPE
&trans     &trans           &trans        &trans                &trans                 &trans      &trans  &trans                                                                         &trans
            >;

            sensor-bindings = <&rsr_trans>;
        };

        NUM {
            display-name = "2 NUM";
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                           &trans      &kp F7  &kp F8  &kp F9  &kp F10
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK  &kp LC(LA(KP_NUMBER_0))      &trans  &trans      &kp F4  &kp F5  &kp F6  &kp F11
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL                    &trans  &kp ESCAPE  &kp F1  &kp F2  &kp F3  &kp F12
&trans                      &trans           &trans           &trans           &trans        &trans                       &trans  &trans                              &kp F13
            >;

            sensor-bindings = <&rsr_trans>;
        };

        ARROW {
            display-name = "3 ARROW";
            bindings = <
&kp LG(LEFT_ARROW)  &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &kp LG(RIGHT_ARROW)                      &kp LG(LEFT_ARROW)  &kp LS(LC(TAB))         &kp UP_ARROW    &kp LC(TAB)              &kp LG(RIGHT_ARROW)
&kp HOME            &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END              &trans      &trans  &kp HOME            &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END
&kp LEFT_SHIFT      &kp LG(LC(LEFT_ARROW))  &trans          &kp LG(LC(RIGHT_ARROW))  &trans               &trans      &trans  &trans              &kp LC(LG(LEFT_ARROW))  &trans          &kp LG(LC(RIGHT_ARROW))  &trans
&trans              &trans                  &trans          &trans                   &trans               &trans      &trans  &trans                                                                               &trans
            >;

            sensor-bindings = <&rsr_tab>;
        };

        MOUSE {
            display-name = "4 MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;

            sensor-bindings = <&rsr_trans>;
        };

        // 使っていない（入るキーがない）。消すとレイヤー 6・7 の番号が 1 つずつ繰り上がり、
        // Studio に保存した割り当てと OS レイヤー（7）の設定がずれるので残している
        SCROLL {
            display-name = "5 SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&rsr_trans>;
        };

        layer_6 {
            display-name = "6 SYSTEM";
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &kp NUMBER_4  &trans        &trans        &trans  &trans      &trans       &studio_unlock  &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans          &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                    &bt BT_CLR_ALL
            >;

            sensor-bindings = <&rsr_trans>;
        };

        // OS レイヤー: 接続先の OS に応じて DYA Studio の Connection タブから自動で重ねる差分レイヤー
        // （config/roBa_R.conf の CONFIG_ZMK_DEFAULT_LAYER_MIN/MAX_INDEX=7 で、このレイヤーだけを管理させる）。
        // 初期値はすべて透過で、動作は変わらない。Mac 用の差分キーは DYA Studio で置く。
        // 最上位のレイヤーなので、ここに置いたキーはレイヤー 1〜6 の同じ位置より優先される
        os_layer {
            display-name = "7 OS";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&rsr_trans>;
        };
    };
};
