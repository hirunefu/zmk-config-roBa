#include "roBa.dtsi"
#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>
#include <dt-bindings/zmk/input_transform.h>

&default_transform {
    col-offset = <6>;
};

&kscan0 {
        col-gpios
            = <&xiao_d 10 GPIO_ACTIVE_HIGH>
            , <&xiao_d 9 GPIO_ACTIVE_HIGH>
            , <&xiao_d 8 GPIO_ACTIVE_HIGH>
            , <&xiao_d 7 GPIO_ACTIVE_HIGH>
            , <&gpio0 10 GPIO_ACTIVE_HIGH>
            ;
};

// オートマウス: トラックボールを動かしている間だけレイヤー 4（MOUSE）を有効にする。
// ここは初期値で、DYA Studio で変更して保存した値があればそちらが優先される。
&mouse_runtime_input_processor {
    temp-layer-enabled;
    temp-layer = <4>;
    // 有効化の待ち時間は既定値（直前のキー入力から 100 ms）のまま
    temp-layer-deactivation-delay-ms = <700>;
};

// スクロールの慣性（弾くと惰性で流れる）を既定で有効にする。DYA Studio で保存した値があればそちらが優先される。
// 公開版の DYA Studio には慣性の設定画面がないので、調整は開発版（dya-studio-dev）で行う
&scroll_runtime_input_processor {
    inertia-enabled;
};

/ {
    trackball_listener {
        status = "okay";
        compatible = "zmk,input-listener";
        device = <&trackball>;
        input-processors = <&mouse_runtime_input_processor>;

        scroller {
            layers = <5>;
            // Y 反転は入力プロセッサ（RIP）より前に置く。慣性の出力は RIP から直接ホストへ送られて
            // 後段のプロセッサを通らないため、後ろで反転すると慣性だけ逆向きに流れる
            input-processors =
                <&zip_xy_to_scroll_mapper>,
                <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,
                <&scroll_runtime_input_processor>;
        };
    };
};

&pinctrl {
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

&xiao_serial { status = "disabled"; };

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball: trackball@0 {
        status = "okay";
        compatible = "cormoran,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        // 普段使っているエレコム IST PLUS（800 DPI に設定）と、指を同じだけ動かしたときの
        // カーソルの移動量をそろえる。センサーが受け付けるのは 200 刻み（200〜3200）。
        // DYA Studio で保存した値があれば、そちらが優先される
        cpi = <800>;
        evt-type = <INPUT_EV_REL>;
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
        // 実行時設定のキー "<param>@tb" に使う ID（保存名の長さ制限があるので短くする）
        settings-id = "tb";
    };
};
